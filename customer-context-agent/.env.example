# Local mock mode
MOCK_BASE_URL=

# FastAPI server (optional)
# API_HOST=0.0.0.0
# API_PORT=8000

# Real API mode (set API_BASE_URL and auth settings below when access is granted)
# API_BASE_URL=https://internal-api-base.example.com

# Xiphos mTLS
# XIPHOS_CLIENT_CERT=/path/to/client.crt
# XIPHOS_CLIENT_KEY=/path/to/client.key
# XIPHOS_CA_BUNDLE=/path/to/ca-bundle.pem

# Customer API OAuth2 Client Credentials
# CUSTOMER_OAUTH_URL=https://auth.example.com/oauth/token
# CUSTOMER_CLIENT_ID=your-client-id
# CUSTOMER_CLIENT_SECRET=your-client-secret
# CUSTOMER_OAUTH_SCOPE=optional-scope
# CUSTOMER_OAUTH_AUDIENCE=optional-audience
# CUSTOMER_BEARER_TOKEN=optional-static-token

# Chakra x20 token auth
# CHAKRA_X20_HEADER=x20-token
# CHAKRA_X20_TOKEN=your-x20-token
